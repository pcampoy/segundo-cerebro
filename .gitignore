# ───────────────────────────────────────────────
#  .gitignore del vault de Obsidian — Pilar / Pilita
# ───────────────────────────────────────────────

# --- Obsidian: estado volátil por dispositivo (da conflictos, no aporta) ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json
.trash/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- SEGURIDAD: nunca subir secretos ni credenciales ---
*config*.json
*.env
.env
.env.*
*credential*
*password*
*token*
*.key
*.pem
*.pfx

# OJO con "secret": en Windows core.ignorecase=true, así que un patrón *secret*
# se traga cualquier nota que mencione "Secretaría" y deja de respaldarla en
# silencio. Por eso aquí sólo se excluyen ficheros de secretos de verdad.
*.secret
*.secrets
secret.*
secrets.*
*.secret.*
*.secrets.*

# --- Carpetas para material sensible (si las creas, quedan fuera del repo) ---
/Privado/
/_secretos/
/Datos personales/
